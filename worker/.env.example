# CreatorFlow worker environment.
# Copy this file to .env in the worker folder, fill in what you use, then run:
#   npm run now      start immediately and keep rendering as you drop batches
#   npm run once     process the current batch once and exit
# Storytime narration is free and locked to the selected Ava female voice.

# ----- Required story understanding and presenter-age verification -----
# ANTHROPIC_API_KEY=

# ----- Storytime voice (free, no key, no alternatives) -----
# Install once: python3 -m pip install edge-tts pillow
# The voice is en-US-AvaMultilingualNeural and cannot be overridden by CSV or env.

# ----- Rendering -----
CF_STYLE=story
CF_SCENE_SECONDS=4.2
CF_WIDTH=1920
CF_HEIGHT=1080
CF_CRF=20
CF_ZOOM=0.06
# The presenter remains still while story images move.
CF_PRESENTER_ZOOM=0
# The presenter split and captions are locked to the supplied reference:
# 38% presenter left, matching scene right, Montserrat ExtraBold at 6% frame
# height, four uppercase words, black outline, purple active-word box.
# Presenter identities are recorded in output/.presenter-history.json and never reused.
CF_INTERVAL=60

# ----- YouTube auto upload, optional -----
# YT_CLIENT_ID=
# YT_CLIENT_SECRET=
# YT_REFRESH_TOKEN=
# CF_YT_PRIVACY=unlisted
